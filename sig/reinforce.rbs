module Reinforce
  VERSION: String

  # The one thing every algorithm in this library has in common: given a
  # state, it can produce an action. See lib/reinforce/agent.rb for why
  # #train/#save/#load are deliberately not part of this contract.
  module Agent
    # @parameter state a state from the environment's state space.
    # @parameter deterministic greedy if true (the default), sampled if false.
    # @returns an element of the environment's `actions` array.
    def predict: (untyped state, ?deterministic: bool) -> untyped
  end

  # The contract every environment in this library follows. See
  # lib/reinforce/environment.rb and readme.md's "Define a new environment"
  # section for the narrative version of this contract.
  module Environment
    # Reset the environment to its initial state.
    # @returns the initial state.
    def reset: () -> untyped

    # @returns the size of the state vector.
    def state_size: () -> Integer

    # @returns the available actions. For a discrete action space,
    #   `actions.size` gives the number of actions, and #step accepts
    #   either an element of this array or its index into it.
    def actions: () -> Array[untyped]

    # Execute an action and advance the environment by one step.
    # @parameter action an element of #actions, or its index.
    # @returns a 4-tuple of `(next_state, reward, done, info)`.
    def step: (untyped action) -> [untyped, Numeric, bool, Hash[untyped, untyped]]

    # Render the environment to an output stream. Optional: unlike the
    # methods above, no algorithm in this library depends on #render.
    def render: (?IO output_stream) -> void
  end

  module Metrics
    # Anything responding to `call(key, value, step)`, e.g. a lambda.
    interface _Sink
      def call: (Symbol key, Numeric value, Integer step) -> untyped
    end

    # Collects the scalar metrics an algorithm records while training and
    # forwards each value to its sinks. See lib/reinforce/metrics/recorder.rb.
    class Recorder
      include Enumerable[[Symbol, Array[Numeric]]]

      attr_reader sinks: Array[_Sink]

      def initialize: (?sinks: Array[_Sink]) -> void
      def add_sink: (_Sink sink) -> self
      def record: (Symbol | String key, Numeric value, ?step: Integer?) -> Numeric
      def record_all: (Hash[Symbol, Numeric] metrics, ?step: Integer?) -> Hash[Symbol, Numeric]
      def []: (Symbol | String key) -> Array[Numeric]
      def keys: () -> Array[Symbol]
      def key?: (Symbol | String key) -> bool
      def each: () { ([Symbol, Array[Numeric]]) -> void } -> self
              | () -> Enumerator[[Symbol, Array[Numeric]], self]
      def last: (Symbol | String key) -> Numeric?
      def mean: (Symbol | String key, ?window: Integer?) -> Float?
      def to_h: () -> Hash[Symbol, Array[Numeric]]
    end

    # Prints a one-line summary every `every` values of the `trigger` metric.
    class ConsoleSink
      include _Sink

      def initialize: (?output: IO, ?every: Integer, ?trigger: Symbol, ?precision: Integer) -> void
    end

    # Writes every recorded value as one JSON object per line.
    class JSONLinesSink
      include _Sink

      def initialize: (String | IO destination, ?clock: ^() -> Float) -> void
      def close: () -> void
    end
  end
end
